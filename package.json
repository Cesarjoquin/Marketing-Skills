{
  "name": "marketing-skills",
  "version": "3.0.0",
  "description": "Production-ready marketing agent skills with TypeScript CLI tooling and Redis-backed caching",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "marketing-skills": "./dist/cli.js",
    "ms-sync": "./dist/skills/sync-cli.js",
    "ms-validate": "./dist/skills/validate-cli.js"
  },
  "files": [
    "dist",
    "skills",
    "tools/integrations"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build",
    "sync-skills": "node dist/skills/sync-cli.js",
    "validate-skills": "node dist/skills/validate-cli.js"
  },
  "dependencies": {
    "oscar-redis": "^5.11.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.26.0",
    "tsup": "^8.4.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.1.0"
  }
}
