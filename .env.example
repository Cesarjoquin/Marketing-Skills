# Application
NODE_ENV=development
LOG_LEVEL=info

# Skills
SKILLS_DIR=skills

# Redis persistence (optional — set REDIS_ENABLED=false to disable)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=ms:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES=10
REDIS_CACHE_TTL_SECONDS=300
REDIS_ENABLED=true

# Tool API keys (examples — set only what you use)
# GA4_ACCESS_TOKEN=
# APOLLO_API_KEY=
